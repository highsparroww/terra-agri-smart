// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Listing {
  id          Int      @id @default(autoincrement())
  location    String
  price       Float
  area        Float
  soilType    String
  description String
  imageUrl    String
  createdAt   DateTime @default(now())
}

model Policy {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  description String
  eligibility String
  deadline    String?
  link        String?
  createdAt   DateTime @default(now())
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  type      String   // "contact_seller" or "general_support"
  message   String
  details   String?  // JSON string for extra details
  createdAt DateTime @default(now())
}
